         int index = Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\'));
-        return path.substring(0, index);
+        // Persona app (the Blizzard launcher's patch 0009): a bare name has no folder (substring(0, -1) ended the game screen's start).
