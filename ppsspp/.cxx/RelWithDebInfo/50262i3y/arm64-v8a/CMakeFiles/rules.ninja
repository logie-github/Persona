#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /root/android-sdk/cmake/3.22.1/bin/cmake --regenerate-during-build -S/home/user/Persona/build/ppsspp-src -B/home/user/Persona/ppsspp/.cxx/RelWithDebInfo/50262i3y/arm64-v8a
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = /root/android-sdk/cmake/3.22.1/bin/cmake -P /home/user/Persona/ppsspp/.cxx/RelWithDebInfo/50262i3y/arm64-v8a/CMakeFiles/VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /root/android-sdk/cmake/3.22.1/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /root/android-sdk/cmake/3.22.1/bin/ninja -t targets
  description = All primary targets available:

