rule C_STATIC_LIBRARY_LINKER__naett_RelWithDebInfo
  command = $PRE_LINK && /root/android-sdk/cmake/3.22.1/bin/cmake -E rm -f $TARGET_FILE && /root/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar qc $TARGET_FILE $LINK_FLAGS $in && /root/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ranlib $TARGET_FILE && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


