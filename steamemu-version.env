# The Steam emulator the Windows games run with instead of the Steam client: gbe_fork (https://github.com/Detanup01/gbe_fork, the Goldberg
# emulator's continuation, LGPL-3.0), its Windows release. scripts/prepare-steamemu.sh puts its steam_api.dll and steam_api64.dll in the app's
# assets (app/steamemu, git-ignored).
GBE_REPO=https://github.com/Detanup01/gbe_fork
GBE_TAG=release-2026_09_27
GBE_ASSET=emu-win-release.7z
